{
  "name": "weibo-emoji-monitor",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node -r ./src/skip-db-init-preload.js -r ./src/postgres-preload.js -r ./src/superlike-pagination-preload.js server.js",
    "dev": "node -r ./src/skip-db-init-preload.js -r ./src/postgres-preload.js -r ./src/superlike-pagination-preload.js --watch server.js",
    "rebuild-comments": "node -r ./src/skip-db-init-preload.js -r ./src/postgres-preload.js src/rebuild-comments.js",
    "recheck-superlike": "node -r ./src/skip-db-init-preload.js -r ./src/postgres-preload.js -r ./src/playwright-hardening.js -r ./src/mode2-dynamic-comment-threshold-preload.js scripts/recheck-superlike.js",
    "scan-superlike": "node -r ./src/skip-db-init-preload.js -r ./src/postgres-preload.js -r ./src/playwright-hardening.js scripts/start-superlike-workers.js",
    "setup-proxies": "node -r ./src/skip-db-init-preload.js scripts/setup-webshare-proxies.js",
    "test-proxyclean": "node -r ./src/skip-db-init-preload.js -r ./src/postgres-preload.js -r ./src/playwright-hardening.js scripts/test-proxyclean.js",
    "build-weibo-proxies": "node -r ./src/skip-db-init-preload.js -r ./src/postgres-preload.js -r ./src/playwright-hardening.js scripts/build-weibo-proxy-pool.js",
    "test-mode4-no-login": "node -r ./src/skip-db-init-preload.js -r ./src/postgres-preload.js -r ./src/playwright-hardening.js scripts/test-mode4-no-login.js",
    "start:prod": "node -r ./src/skip-db-init-preload.js -r ./src/postgres-preload.js -r ./src/superlike-pagination-preload.js server.js",
    "start:test": "node -r ./src/skip-db-init-preload.js -r ./src/postgres-preload.js scripts/start-test.js",
    "test-db:refresh": "node -r ./src/skip-db-init-preload.js scripts/migrate-sqlite-to-postgres.js",
    "scan-superlike:test": "node -r ./src/skip-db-init-preload.js -r ./src/postgres-preload.js -r ./src/playwright-hardening.js scripts/run-test-scan.js",
    "scan-superlike:legacy": "node -r ./src/skip-db-init-preload.js -r ./src/postgres-preload.js -r ./src/playwright-hardening.js src/superlike-scanner.js",
    "export-weibo-login": "node -r ./src/skip-db-init-preload.js -r ./src/playwright-hardening.js scripts/export-weibo-login-state.js",
    "jyz-login": "node -r ./src/skip-db-init-preload.js -r ./src/playwright-hardening.js scripts/jyz-login.js",
    "jyz-service": "node -r ./src/skip-db-init-preload.js -r ./src/playwright-hardening.js scripts/jyz-service.js",
    "backfill-today-jyz": "node -r ./src/skip-db-init-preload.js -r ./src/postgres-preload.js -r ./src/playwright-hardening.js scripts/backfill-today-jyz.js",
    "refresh-old-superlike": "node -r ./src/skip-db-init-preload.js -r ./src/postgres-preload.js -r ./src/playwright-hardening.js scripts/refresh-old-superlike-posts.js",
    "normalize-superlike-post-time": "node -r ./src/skip-db-init-preload.js scripts/normalize-superlike-post-created-at.js",
    "comment-assistant": "node -r ./src/skip-db-init-preload.js ./scripts/comment-assistant/cli.js",
    "comment-assistant-ui": "node -r ./src/skip-db-init-preload.js ./scripts/comment-assistant/web.js",
    "db:init": "node -r ./src/postgres-preload.js scripts/run-init-database.js",
    "db:pg:init": "node -r ./src/skip-db-init-preload.js -r ./src/postgres-preload.js scripts/init-postgres.js",
    "db:pg:migrate": "node -r ./src/skip-db-init-preload.js scripts/migrate-sqlite-to-postgres.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
