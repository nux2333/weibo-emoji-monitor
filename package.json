{
  "name": "weibo-emoji-monitor",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node -r ./src/postgres-preload.js server.js",
    "dev": "node -r ./src/postgres-preload.js --watch server.js",
    "rebuild-comments": "node -r ./src/postgres-preload.js src/rebuild-comments.js",
    "recheck-superlike": "node -r ./src/postgres-preload.js -r ./src/playwright-hardening.js scripts/recheck-superlike.js",
    "scan-superlike": "node -r ./src/postgres-preload.js -r ./src/playwright-hardening.js scripts/start-superlike-workers.js",
    "setup-proxies": "node scripts/setup-webshare-proxies.js",
    "test-proxyclean": "node -r ./src/postgres-preload.js -r ./src/playwright-hardening.js scripts/test-proxyclean.js",
    "build-weibo-proxies": "node -r ./src/postgres-preload.js -r ./src/playwright-hardening.js scripts/build-weibo-proxy-pool.js",
    "test-mode4-no-login": "node -r ./src/postgres-preload.js -r ./src/playwright-hardening.js scripts/test-mode4-no-login.js",
    "start:prod": "node -r ./src/postgres-preload.js server.js",
    "start:test": "node -r ./src/postgres-preload.js scripts/start-test.js",
    "test-db:refresh": "node scripts/migrate-sqlite-to-postgres.js",
    "scan-superlike:test": "node -r ./src/postgres-preload.js -r ./src/playwright-hardening.js scripts/run-test-scan.js",
    "scan-superlike:legacy": "node -r ./src/postgres-preload.js -r ./src/playwright-hardening.js src/superlike-scanner.js",
    "export-weibo-login": "node -r ./src/playwright-hardening.js scripts/export-weibo-login-state.js",
    "jyz-login": "node -r ./src/playwright-hardening.js scripts/jyz-login.js",
    "jyz-service": "node -r ./src/playwright-hardening.js scripts/jyz-service.js",
    "backfill-today-jyz": "node -r ./src/postgres-preload.js -r ./src/playwright-hardening.js scripts/backfill-today-jyz.js",
    "refresh-old-superlike": "node -r ./src/postgres-preload.js -r ./src/playwright-hardening.js scripts/refresh-old-superlike-posts.js",
    "db:pg:init": "node -r ./src/postgres-preload.js scripts/init-postgres.js",
    "db:pg:migrate": "node scripts/migrate-sqlite-to-postgres.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
