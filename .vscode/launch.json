{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug comment-assistant 账号1",
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": [
        "run",
        "comment-assistant",
        "--",
        "3"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "autoAttachChildProcesses": true
    }
  ]
}