PORT=3000
ADMIN_TOKEN=change-this-token
CRON="0 6 * * *"
TIMEZONE=Asia/Tokyo
MAX_COMMENTS_PER_SOURCE=5000


# ============================================================
# SuperLike Proxy
# ============================================================
# 推荐测试分配：
#   找贴脚本 Scan -> 免费正规代理 A
#   Mode2 评论删帖 -> 免费正规代理 B
#   Mode3 Profile  -> 留空，默认本地 IP
#   Mode4 超LIKE榜 -> 留空，默认本地 IP + Persistent Profile
#
# 支持格式：
# http://host:port
# http://username:password@host:port
#
# WEIBO_PROXY 只作为 Scan / Mode2 / Mode1 的可选 fallback。
# Mode3 / Mode4 不会自动继承 WEIBO_PROXY，避免误用代理影响登录状态。
WEIBO_PROXY=
SUPERLIKE_SCAN_PROXY=
SUPERLIKE_MODE2_PROXY=
SUPERLIKE_MODE3_PROXY=
SUPERLIKE_MODE4_PROXY=
SUPERLIKE_RECHECK_PROXY=
