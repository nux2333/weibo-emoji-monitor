PORT=3000
ADMIN_TOKEN=change-this-token
CRON="0 6 * * *"
TIMEZONE=Asia/Tokyo
MAX_COMMENTS_PER_SOURCE=5000


# Optional fixed proxies for SuperLike scripts.
# Format:
# http://host:port
# http://username:password@host:port
#
# WEIBO_PROXY is the fallback shared proxy.
# Per-script/per-mode values override WEIBO_PROXY.
WEIBO_PROXY=
SUPERLIKE_SCAN_PROXY=
SUPERLIKE_MODE2_PROXY=
SUPERLIKE_MODE3_PROXY=
SUPERLIKE_MODE4_PROXY=
SUPERLIKE_RECHECK_PROXY=
