PORT=3000
ADMIN_TOKEN=change-this-token
CRON="0 6 * * *"
TIMEZONE=Asia/Tokyo
MAX_COMMENTS_PER_SOURCE=5000


# ============================================================
# SuperLike Proxy
# ============================================================
# 推荐测试分配：
#   找贴脚本 Scan -> 免费正规代理 A
#   Mode2 评论删帖 -> 免费正规代理 B
#   Mode3 Profile  -> 留空，默认本地 IP
#   Mode4 超LIKE榜 -> 留空，默认本地 IP + Persistent Profile
#
# 支持格式：
# http://host:port
# http://username:password@host:port
#
# WEIBO_PROXY 只作为 Scan / Mode2 / Mode1 的可选 fallback。
# Mode3 / Mode4 不会自动继承 WEIBO_PROXY，避免误用代理影响登录状态。
#
# 代理池：用逗号、分号或换行分隔。
# Scan / Mode2 每一轮只选择一个代理，下一轮再轮到下一个。
# 某个代理命中 HTTP 418 后进入冷却，不会在当前轮立刻切IP继续请求。
# 如果整个池都在冷却，本轮直接跳过。
WEIBO_PROXY=

# 单个固定代理（未配置代理池时使用）
SUPERLIKE_SCAN_PROXY=
SUPERLIKE_MODE2_PROXY=

# 多代理池示例：
# SUPERLIKE_SCAN_PROXY_POOL=http://user:pass@ip1:port,http://user:pass@ip2:port
# SUPERLIKE_MODE2_PROXY_POOL=http://user:pass@ip6:port,http://user:pass@ip7:port
SUPERLIKE_SCAN_PROXY_POOL=
SUPERLIKE_MODE2_PROXY_POOL=

# 418 后单个代理默认冷却30分钟
SUPERLIKE_PROXY_COOLDOWN_MS=1800000

# Mode3 / Mode4 默认本地IP
SUPERLIKE_MODE3_PROXY=
SUPERLIKE_MODE4_PROXY=
SUPERLIKE_RECHECK_PROXY=
