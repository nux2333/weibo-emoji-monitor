PORT=3000
ADMIN_TOKEN=change-this-token
CRON="0 6 * * *"
TIMEZONE=Asia/Tokyo
MAX_COMMENTS_PER_SOURCE=5000


# ============================================================
# SuperLike Proxy
# ============================================================
# 默认：
#   Scan  -> SCDN 动态 HTTPS 代理池
#   Mode2 -> SCDN 动态 HTTPS 代理池
#   Mode3 -> 本地 IP
#   Mode4 -> 本地 IP + Persistent Profile
#
# SCDN API 每次最多获取20个候选代理。
# 程序会在可用候选不足时自动补池，并在补池后随机打乱顺序。
# 代理连接层失败会从当前内存池淘汰；418则按现有冷却逻辑处理。
#
# 如需临时完全关闭动态代理：
# SUPERLIKE_DISABLE_DYNAMIC_PROXY=1
SUPERLIKE_DISABLE_DYNAMIC_PROXY=0

# 动态池至少保持多少个“未冷却候选”
SUPERLIKE_DYNAMIC_PROXY_MIN_SIZE=3

# 每次从 SCDN 获取多少个（最大20）
SUPERLIKE_DYNAMIC_PROXY_FETCH_COUNT=20

# 每批代理先做 HTTPS CONNECT 预检。
# 单个代理预检超时默认5秒，并发10个。
SUPERLIKE_PROXY_HEALTH_TIMEOUT_MS=5000
SUPERLIKE_PROXY_HEALTH_CONCURRENCY=10

# 一批20个如果健康代理不足，会继续取下一批。
# 默认最多连续测试3批，避免无限请求SCDN。
SUPERLIKE_DYNAMIC_PROXY_HEALTH_BATCHES=3

# SCDN筛选协议
SUPERLIKE_DYNAMIC_PROXY_PROTOCOL=https

# 可选国家代码，例如 JP / US / CN；留空=不限国家
SUPERLIKE_DYNAMIC_PROXY_COUNTRY=

# 单个代理418后的默认冷却时间：30分钟
SUPERLIKE_PROXY_COOLDOWN_MS=1800000

# 可选：手工代理/代理池仍然支持，会与动态池合并
WEIBO_PROXY=
SUPERLIKE_SCAN_PROXY=
SUPERLIKE_MODE2_PROXY=
SUPERLIKE_SCAN_PROXY_POOL=
SUPERLIKE_MODE2_PROXY_POOL=

# Mode3 / Mode4 默认本地IP
SUPERLIKE_MODE3_PROXY=
SUPERLIKE_MODE4_PROXY=
SUPERLIKE_RECHECK_PROXY=
